#!/bin/sh
# Generated by Meson. Prefer the private venv interpreter (created by
# `make install` with --system-site-packages, so system PyGObject/GTK stay
# visible); fall back to the Meson-detected interpreter when there is no venv —
# the Flatpak bundles its dependencies into the runtime instead of a venv.
PYTHONPATH="@pythondir@${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONPATH
if [ -x "@venvpython@" ]; then
    exec "@venvpython@" -m markdown_vault.main "$@"
fi
exec "@python@" -m markdown_vault.main "$@"
