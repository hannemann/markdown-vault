#!/bin/bash
# Pre-commit hook: auto-update the dependency map in AGENTS.md.
# Run from project root — replaces the <!-- DEPENDENCY_MAP_START --> ...
# <!-- DEPENDENCY_MAP_END --> block with fresh output.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Run dep_map.py and capture output
OUTPUT="$(python3 "$ROOT/scripts/dep_map.py")"

# Replace the marker block in AGENTS.md
AGENTS="$ROOT/AGENTS.md"
TEMP="$(mktemp)"

python3 - "$AGENTS" "$OUTPUT" "$TEMP" <<'PYEOF'
import sys

agents_path, new_map, temp_path = sys.argv[1], sys.argv[2], sys.argv[3]
content = open(agents_path).read()

import re
pattern = r'(<!-- DEPENDENCY_MAP_START -->\n).*?(<!-- DEPENDENCY_MAP_END -->)'
replacement = f'\\1{new_map}\\n\\n\\2'
new_content = re.sub(pattern, replacement, content, flags=re.DOTALL)

open(temp_path, 'w').write(new_content)
PYEOF

# Only update if changed
if cmp -s "$AGENTS" "$TEMP"; then
    rm "$TEMP"
else
    mv "$TEMP" "$AGENTS"
    echo "  Updated AGENTS.md (dependency map)" >&2
fi
